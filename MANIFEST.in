include README.md CHANGELOG.md CONTRIBUTING.md LICENSE pyproject.toml
recursive-include docs *.md
recursive-include examples *.py
recursive-include requirements *.txt
recursive-include test_suite/tests *.py
exclude tools/*.py
include tools/check_installed_package.py
include tools/run_integration_tests.py
include tools/generate_ground_truth.py
include tools/benchmark_cluster_moves.py
include tools/benchmark_performance_baseline.py
recursive-include tools/qualification *.py
prune docs/internal
prune implementation
prune reference
prune test_suite/vendor
prune tools/local
global-exclude __pycache__ *.py[cod]
